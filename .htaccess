<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Handle API endpoints
  RewriteRule ^api/auth/login/?$ api/login.php [L,QSA]
  RewriteRule ^api/quotes/?$ api/quotes.php [L,QSA]
  RewriteRule ^api/contacts/?$ api/contacts.php [L,QSA]
  RewriteRule ^api/products/?$ api/products.php [L,QSA]
  RewriteRule ^api/health/?$ api/health.php [L,QSA]

  # Allow existing real files and directories to be served directly
  RewriteRule ^index\.html$ - [L]
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteCond %{REQUEST_FILENAME} !-l

  # Route all other URLs (e.g. /admin, /products/*, /shop) to index.html for Single Page Application
  RewriteRule . /index.html [L]
</IfModule>
